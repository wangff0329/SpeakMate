{
  "name": "speakmate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "bun run --cwd apps/web build",
    "dev:api": "bun --hot apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev": "bun run dev:api"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
